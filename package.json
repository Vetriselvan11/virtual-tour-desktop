{
  "name": "virtual-tour-desktop",
  "version": "1.1.7",
  "description": "Virtual Tour Engine Desktop Application",
  "main": "main.js",
  "author": "Vetriselvan",
  "scripts": {
    "start": "electron .",
    "build:frontend": "cd frontend && npm.cmd run build",
    "dist": "electron-builder --win",
    "release": "electron-builder --win -p always"
  },
  "build": {
    "appId": "com.virtualtour.desktop",
    "productName": "Virtual Tour Engine",
    "publish": [
      {
        "provider": "github",
        "owner": "Vetriselvan11",
        "repo": "virtual-tour-desktop"
      }
    ],
    "directories": {
      "output": "dist"
    },
    "files": [
      "main.js",
      "backend/src/**/*",
      "backend/export/**/*",
      "backend/package.json",
      "!backend/export/export_*/**",
      "!backend/tours/**",
      "!backend/uploads/**",
      "!backend/test_*",
      "frontend/build/**/*"
    ],
    "win": {
      "target": [
        {
          "target": "nsis",
          "arch": [
            "x64"
          ]
        }
      ]
    },
    "nsis": {
      "oneClick": false,
      "allowToChangeInstallationDirectory": true,
      "createDesktopShortcut": true,
      "createStartMenuShortcut": true,
      "runAfterFinish": true
    }
  },
  "dependencies": {
    "archiver": "^8.0.0",
    "cors": "^2.8.5",
    "dotenv": "^17.4.2",
    "electron-log": "^5.4.4",
    "electron-updater": "^6.8.9",
    "express": "^4.18.2",
    "express-rate-limit": "^8.6.1",
    "mongoose": "^9.7.3",
    "multer": "^1.4.5-lts.1",
    "uuid": "^9.0.0"
  },
  "devDependencies": {
    "electron": "^28.2.0",
    "electron-builder": "^24.13.3"
  }
}
